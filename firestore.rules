rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'dvrmercadinho@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMINISTRADOR'
      );
    }

    function isStaff() {
      return isAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    // 1. Menu Items: Publicly readable for customer cardápio; editable only by Admin
    match /menu_items/{itemId} {
      allow read: if isValidId(itemId);
      allow create, update, delete: if isValidId(itemId) && isAdmin();
    }

    // 2. Restaurant Config: Publicly readable for store status & PIX info; editable only by Admin
    match /configs/{configId} {
      allow read: if isValidId(configId);
      allow create, update, delete: if isValidId(configId) && isAdmin();
    }

    // 3. Orders: Secure creation for clients and PDV; status updates for staff; protected lists
    match /orders/{orderId} {
      // Individual order tracking permitted by ID
      allow get: if isValidId(orderId);
      
      // Full order list queries restricted to staff
      allow list: if isStaff();

      // Creation allows customer orders or staff POS orders with strict field constraints
      allow create: if isValidId(orderId) &&
        incoming().keys().hasAll(['id', 'orderNumber', 'fulfillmentType', 'totalAmount', 'paymentMethod', 'paymentStatus', 'status']) &&
        incoming().id == orderId &&
        incoming().orderNumber is string && incoming().orderNumber.size() <= 32 &&
        incoming().fulfillmentType in ['DELIVERY', 'RETIRADA'] &&
        incoming().paymentMethod in ['PIX', 'CARTAO_CREDITO', 'CARTAO_DEBITO', 'DINHEIRO'] &&
        incoming().paymentStatus in ['PENDENTE', 'PAGO'] &&
        incoming().status in ['NOVO', 'EM_PREPARO'] &&
        incoming().totalAmount is number && incoming().totalAmount >= 0;

      // Updates restricted to authenticated staff (KDS, POS, Delivery, Admin)
      allow update: if isValidId(orderId) && isStaff() && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'movements', 'paymentStatus', 'deliveryPerson', 'cancellationReason', 'cancelledBy'])
      );

      // Deletion strictly restricted to Administrator
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // 4. Cash Register Shifts: Restricted to operational staff
    match /cash_shifts/{shiftId} {
      allow read, write: if isValidId(shiftId) && isStaff();
    }

    // 5. Users & Roles: Read by staff; write strictly restricted to Admin
    match /users/{userId} {
      allow read: if isValidId(userId) && isStaff();
      allow create, update, delete: if isValidId(userId) && isAdmin();
    }

    // 6. Access Audit Logs: Read by Admin; append by staff; immutable
    match /access_logs/{logId} {
      allow read: if isValidId(logId) && isAdmin();
      allow create: if isValidId(logId) && isStaff();
      allow update, delete: if false;
    }
  }
}
