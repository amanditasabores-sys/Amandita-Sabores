# ==============================================================================
# AMANDITA SABORES - VARIÁVEIS DE AMBIENTE
# ==============================================================================

# Credenciais do Projeto Firebase existente: "Amandita" (ID: amandita-sabores)
# Obtenha estas chaves em: Firebase Console -> amandita-sabores -> Configurações do Projeto -> Seus Aplicativos (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=amandita-sabores.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=amandita-sabores
VITE_FIREBASE_STORAGE_BUCKET=amandita-sabores.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave de recuperação emergencial do Administrador (SOMENTE SERVIDOR - sem prefixo VITE_)
# Deixe vazia em operação normal; configure temporariamente (>= 16 caracteres) apenas em caso de recuperação administrativa.
ADMIN_RECOVERY_KEY=

# Firebase Admin SDK no Servidor / Vercel (Recomendado para operações privilegiadas no Firestore)
# Opção A: JSON completo da conta de serviço em linha única
FIREBASE_SERVICE_ACCOUNT=
# Opção B: Credenciais individuais (alternativa à Opção A)
FIREBASE_PROJECT_ID=amandita-sabores
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Notificações Push em Segundo Plano (Web Push)
# Configure na Vercel: VAPID_PUBLIC_KEY e VAPID_PRIVATE_KEY geradas pelo web-push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Opcional: Chave de API Google Gemini (para recursos de IA no servidor)
GEMINI_API_KEY=
